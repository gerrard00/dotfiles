{
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 2
  },
  "enabledPlugins": {
    "chrome-devtools-mcp@claude-plugins-official": true,
    "datadog@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "chrome-devtools-plugins": {
      "source": {
        "source": "github",
        "repo": "ChromeDevTools/chrome-devtools-mcp"
      }
    }
  },
  "effortLevel": "medium",
  "tui": "fullscreen",
  "theme": "dark-ansi",
  "editorMode": "vim"
}
